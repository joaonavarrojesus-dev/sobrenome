class FamiliaNavarro:
    def __init__(self):
        self.sobrenome = "Navarro"
        self.origem = "Espanha / Região de Navarra (Pirenéus)"
        self.significado = "Relativo ou pertencente à antiga região de Navarra."
        self.etimologia_basca = "Derivado de 'naba' (vale entre montanhas ou planície cercada de elevações)."
        
    def exibir_historico(self):
        print("=" * 60)
        print(f"🏰 DOSSIÉ COMPLETO: FAMÍLIA {self.sobrenome.upper()} 🏰")
        print("=" * 60)
        print(f"🌍 Origem Geográfica : {self.origem}")
        print(f"📚 Significado      : {self.significado}")
        print(f"🗣️ Raiz Etimológica : {self.etimologia_basca}")
        print("-" * 60)

    def curiosidades(self):
        fatos = [
            "É um sobrenome de <b>toponímia</b>, ou seja, era dado às pessoas que saíam da região de Navarra para outras terras.",
            "Espalhou-se amplamente pela Península Ibérica durante a Reconquista e, posteriormente, para a América Latina e Brasil.",
            "Historicamente, portadores do nome participaram ativamente da nobreza medieval espanhola e de expedições marítimas."
        ]
        print("🔍 CURIOSIDADES HISTÓRICAS:")
        for i, fato in enumerate(fatos, 1):
            print(f"  {i}. {fato}")
        print("-" * 60)

    def simular_brasao(self):
        print("🛡️ SIMULADOR DE BRASÃO TRADICIONAL:")
        print("  • Cores predominantes: Ouro e Vermelho (representam nobreza, coragem e valentia).")
        print("  • Símbolos comuns: Águias, castelos ou faixas heráldicas.")
        print("  • Lema sugerido: 'Honra, Tradição e Bravura'.")
        print("=" * 60)

# Executando o sistema interativo da família Navarro
if __name__ == "__main__":
    navarro = FamiliaNavarro()
    navarro.exibir_historico()
    navarro.curiosidades()
    navarro.simular_brasao()
    print("✨ 'Carregar o nome Navarro é carregar séculos de história nas veias!' ✨")